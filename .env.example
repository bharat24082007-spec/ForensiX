# ==============================================================================
# ForensiX Platform Configuration
# ==============================================================================

# Application Security
# SECRET_KEY must be a random secret (32+ chars) and changed from the default in production.
SECRET_KEY=forensix_dev_secret_key_9f82d7a6e1c4b53098fbc12478aef6510e

# Single-Host Network Binding (Strict Constraint)
# Default is 127.0.0.1. Any non-loopback host (e.g., 0.0.0.0, 192.168.x.x) is refused
# unless ALLOW_LAN is explicitly set to 'true'.
HOST=127.0.0.1
PORT=5000
ALLOW_LAN=false

# Storage & Directory Paths
# Base data directory where database, evidence vault, work folders, and logs reside.
DATA_DIR=data

# Upload Constraints
MAX_UPLOAD_MB=200

# External Forensics Tools (Subprocess CLI Paths)
# Set absolute paths or ensure binaries are on PATH.
TSHARK_PATH=tshark
CAPINFOS_PATH=capinfos
EXIFTOOL_PATH=exiftool
FLS_PATH=fls

# Offline & Security Controls
# EXTERNAL_LOOKUPS: When false, all outbound network reputation lookups are disabled.
EXTERNAL_LOOKUPS=false

# PUBLIC_VERIFY: When false, the report verification endpoint requires authenticated login.
PUBLIC_VERIFY=false

# Watchdog Scheduler
WATCHDOG_INTERVAL_MIN=60
